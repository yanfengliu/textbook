{
  "name": "textbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive textbooks with beautiful type, illustrations, animations, and 3D models. Book 1: biology.",
  "scripts": {
    "dev": "node --require ./tools/zj-quiet-browser.cjs tools/serve.js",
    "check": "node --require ./tools/zj-quiet-browser.cjs tools/check-content.js",
    "shot": "node --require ./tools/zj-quiet-browser.cjs tools/shot.js",
    "sweep3d": "node --require ./tools/zj-quiet-browser.cjs tools/sweep3d.js",
    "perf": "node --require ./tools/zj-quiet-browser.cjs tools/perf.js",
    "unit": "node --require ./tools/zj-quiet-browser.cjs --test \"test/*.test.js\"",
    "test": "node --require ./tools/zj-quiet-browser.cjs tools/test.js",
    "audit": "npm audit --audit-level=high",
    "figure": "node --require ./tools/zj-quiet-browser.cjs tools/figure-shot.js",
    "inspect": "node --require ./tools/zj-quiet-browser.cjs tools/inspect.js",
    "flow": "node --require ./tools/zj-quiet-browser.cjs tools/flow.js",
    "drive": "node --require ./tools/zj-quiet-browser.cjs tools/drive.js",
    "pinned": "node --require ./tools/zj-quiet-browser.cjs tools/pinned.js",
    "review": "node --require ./tools/zj-quiet-browser.cjs tools/review.js",
    "progress:export": "node --require ./tools/zj-quiet-browser.cjs tools/progress.js export",
    "progress:import": "node --require ./tools/zj-quiet-browser.cjs tools/progress.js import",
    "subpath": "node --require ./tools/zj-quiet-browser.cjs tools/subpath.js",
    "sitting": "node --require ./tools/zj-quiet-browser.cjs tools/sitting.js",
    "narrow": "node --require ./tools/zj-quiet-browser.cjs tools/narrow.js",
    "legible": "node --require ./tools/zj-quiet-browser.cjs tools/legible.js",
    "devices": "node --require ./tools/zj-quiet-browser.cjs tools/devices.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright": "1.61.1"
  }
}
